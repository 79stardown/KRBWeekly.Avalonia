<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="KRBWeekly.Views.StatisticsView">
    <UserControl.Styles>
        <!-- 日志行压紧一点（只改 ListBoxItem 的内边距，不动默认模板） -->
        <Style Selector="ListBox#LogList > ListBoxItem">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" Spacing="12">
            <!-- 页面标题 -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ui:SymbolIcon Symbol="Play" FontSize="22" VerticalAlignment="Center" />
                <TextBlock Text="自动计算" FontSize="24" FontWeight="Bold" />
            </StackPanel>

            <!-- 配置卡片 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,8" Spacing="6">
                            <TextBlock Text="搜索标签:" FontSize="13" VerticalAlignment="Center" />
                            <ComboBox x:Name="CbSearchTag" Width="210" VerticalAlignment="Center"
                                      ToolTip.Tip="从已有标签里选；下拉最底部可以新建。标签决定起算值、统计记录和黑白名单" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8" Spacing="8">
                            <TextBlock Text="日期:" FontSize="13" VerticalAlignment="Center" />
                            <RadioButton x:Name="RbToday" Content="当天" IsChecked="True"
                                         GroupName="Date" VerticalAlignment="Center"
                                         IsCheckedChanged="DateMode_Changed" />
                            <RadioButton x:Name="RbSpecific" Content="指定"
                                         GroupName="Date" VerticalAlignment="Center"
                                         IsCheckedChanged="DateMode_Changed" />
                            <DatePicker x:Name="DpSpecific" Width="130" IsEnabled="False" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtListStatus" Text="名单: --" FontSize="13" />
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock x:Name="TxtRuleStatus" Text="筛选规则: --" FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 开始按钮 -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnStart"
                        Width="150" Height="36"
                        Click="BtnStart_Click"
                        Background="{DynamicResource SystemAccentColor}" Foreground="White"
                        FontSize="14" FontWeight="SemiBold"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:SymbolIcon Symbol="Play" FontSize="14" Foreground="White" />
                        <TextBlock Text="开始统计" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 进度条 -->
            <Grid>
                <ProgressBar x:Name="ProgressBar" Height="6"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="{DynamicResource SystemAccentColor}" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                <TextBlock x:Name="TxtProgress" Text=""
                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right" Margin="0,8,0,0" />
            </Grid>

            <!-- 日志控制台（占主高度） -->
            <!-- 用虚拟化的 ListBox 而不是一个大 TextBox：几千行文本每次刷整段会重排版，
                 跑到几百个视频时会把 UI 线程拖死（表现为窗口无响应） -->
            <Border Background="#FF1E1E1E" CornerRadius="8" Padding="8">
                <ListBox x:Name="LogList"
                         Background="#FF1E1E1E"
                         BorderThickness="0"
                         Padding="0"
                         Height="420"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Visible">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding}"
                                                 FontFamily="Consolas" FontSize="12"
                                                 Foreground="#FFD4D4D4" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 底部状态栏 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12,8"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
