<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="KRBWeekly.Views.ManualEntryView">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ui:SymbolIcon Symbol="Calculator" FontSize="22" VerticalAlignment="Center" />
                <TextBlock Text="输入-计算" FontSize="24" FontWeight="Bold" />
            </StackPanel>
            <TextBlock Text="手动录入本周新增量，按与自动模式同一套公式计分，独立成榜"
                       FontSize="12" Foreground="#FF605E5C" Margin="34,4,0,0" />
        </StackPanel>

        <!-- 录入表单 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20"
                BorderBrush="#FFE0E0E0" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel Spacing="12">
                <TextBlock x:Name="TxtFormTitle" Text="新增数值组" FontSize="14" FontWeight="SemiBold" />

                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,24,8">
                        <TextBlock Text="编号:" FontSize="13" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtNumber" Width="60" IsReadOnly="True"
                                 FontFamily="Consolas" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,24,8">
                        <TextBlock Text="代号:" FontSize="13" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtCode" Width="200" Watermark="如歌名，可留空"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,8">
                        <TextBlock Text="新增播放:" FontSize="13" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtView" Width="110" Text="0"
                                 FontFamily="Consolas" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,8">
                        <TextBlock Text="新增收藏:" FontSize="13" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtFav" Width="90" Text="0"
                                 FontFamily="Consolas" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,8">
                        <TextBlock Text="新增点赞:" FontSize="13" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtLike" Width="90" Text="0"
                                 FontFamily="Consolas" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,8">
                        <TextBlock Text="新增投币:" FontSize="13" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtCoin" Width="90" Text="0"
                                 FontFamily="Consolas" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,8">
                        <TextBlock Text="发布天数:" FontSize="13" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtDays" Width="90" Watermark="留空=不折算"
                                 FontFamily="Consolas" VerticalContentAlignment="Center" />
                    </StackPanel>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="BtnAdd"
                            Width="130" Height="34" Click="BtnAdd_Click"
                            Background="#FF0078D4" Foreground="White" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:SymbolIcon Symbol="Add" FontSize="13" Foreground="White" />
                            <TextBlock Text="添加条目" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnUpdate" IsVisible="False"
                            Width="130" Height="34" Click="BtnUpdate_Click"
                            Background="#FF107C10" Foreground="White" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:SymbolIcon Symbol="Save" FontSize="13" Foreground="White" />
                            <TextBlock Text="保存修改" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCancelEdit" Content="取消编辑" IsVisible="False"
                            Width="100" Height="34" Click="BtnCancelEdit_Click"
                            Background="White" Foreground="#FF1A1A1A"
                            BorderBrush="#FFD0D0D0" BorderThickness="1" />
                </StackPanel>

                <!-- 计算结果预览（沿用旧核对页的系数/分项展示） -->
                <Border Background="#FFF7F7F7" CornerRadius="6" Padding="12"
                        BorderBrush="#FFEDEDED" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <TextBlock x:Name="TxtCoefs" Text="系数 A=-- B=-- C=--"
                                   FontSize="12" FontFamily="Consolas" Foreground="#FF605E5C" />
                        <TextBlock x:Name="TxtBreakdown" Text="播放分 -- | 收藏分 -- | 赞币分 --"
                                   FontSize="12" FontFamily="Consolas" Foreground="#FF605E5C" />
                        <TextBlock x:Name="TxtPreviewTotal" Text="总分 --"
                                   FontSize="13" FontWeight="Bold" Foreground="#FF0078D4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock x:Name="TxtCount" Text="共 0 个数值组" FontSize="13"
                       Foreground="#FF605E5C" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="BtnExport"
                    Width="130" Height="32" Click="BtnExport_Click"
                    Background="#FF107C10" Foreground="White" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Save" FontSize="13" Foreground="White" />
                    <TextBlock Text="导出名单" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- 条目卡片流（按总分降序） -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="EntryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Padding="12,10,16,10"
                                BorderBrush="#FFE0E0E0" BorderThickness="1" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#FF0078D4" CornerRadius="4"
                                        Width="28" Height="22" VerticalAlignment="Top" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Rank}" Foreground="White" FontSize="12"
                                               FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#FF1A1A1A" />
                                        <TextBlock Text="{Binding NumberStr}" FontSize="11"
                                                   Foreground="#FFA0A0A0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="总分:" FontSize="12" Foreground="#FF605E5C" />
                                            <TextBlock Text="{Binding TotalScoreStr}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="#FF0078D4" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="播放+" FontSize="12" Foreground="#FF605E5C" />
                                            <TextBlock Text="{Binding DeltaViewStr}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="收藏+" FontSize="12" Foreground="#FF605E5C" />
                                            <TextBlock Text="{Binding DeltaFavoriteStr}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="点赞+" FontSize="12" Foreground="#FF605E5C" />
                                            <TextBlock Text="{Binding DeltaLikeStr}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="投币+" FontSize="12" Foreground="#FF605E5C" />
                                            <TextBlock Text="{Binding DeltaCoinStr}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DetailStr}" FontSize="11"
                                               Foreground="#FFA0A0A0" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Top">
                                    <Button Content="编辑" Width="60" Height="28"
                                            Click="BtnEdit_Click" Tag="{Binding}"
                                            Background="White" Foreground="#FF1A1A1A"
                                            BorderBrush="#FFD0D0D0" BorderThickness="1" FontSize="12" />
                                    <Button Content="删除" Width="60" Height="28"
                                            Click="BtnDelete_Click" Tag="{Binding}"
                                            Background="#FFCC0000" Foreground="White" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
